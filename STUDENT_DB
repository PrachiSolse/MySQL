#Write a query to create a database named students_db.
CREATE DATABASE STUDENT_DB;

#1.Create a table students with fields:id, name, age, marks.
USE STUDENT_DB;
CREATE TABLE STUDENT(
     ID INT PRIMARY KEY,
     NAME VARCHAR(50),
     AGE INT NOT NULL,
     MARKS INT NOT NULL
);

#2.Insert 5 records into students table.
INSERT INTO STUDENT VALUES(1,"PRACHI",21,500);
INSERT INTO STUDENT VALUES(2,"SUDHIR",47,900);
INSERT INTO STUDENT VALUES(3,"SANDHYA",45,300);
INSERT INTO STUDENT VALUES(4,"PRIYA",12,580);
INSERT INTO STUDENT VALUES(5,"PARTH",10,590);

#3.Display all records from the students table.
SELECT * FROM STUDENT

#4.Display only the name and marks columns.
 SELECT NAME, MARKS FROM STUDENT;

#5.Count how many rows are in the table.
SELECT COUNT(*) FROM STUDENT;

#6.Select students whose marks are greater than 500.
SELECT NAME FROM STUDENT WHERE MARKS>500;

#7.Select students whose age is equal to 21.
SELECT NAME FROM STUDENT WHERE AGE=21;

#8.Change a student's marks using UPDATE.
UPDATE STUDENT SET MARKS=950 WHERE ID=1;
SELECT * FROM STUDENT

